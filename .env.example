NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/mydb
BETTER_AUTH_SECRET=     # openssl rand -base64 32
# Public URL of the Next.js app — it proxies /api/* to this server.
# Production: https://YOUR_DOMAIN
BETTER_AUTH_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379

# Google OAuth — Google Cloud Console → APIs & Services → Credentials
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI — server-only; never expose to the Next.js client.
OPENAI_API_KEY=

# Optional. Defaults to BETTER_AUTH_URL. Must be an exact origin (no wildcard)
# when credentials/cookies are used.
# CORS_ORIGIN=http://localhost:3000
